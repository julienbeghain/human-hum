node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem

# Dolt database files (added by bd init)
.dolt/
*.db

# Exported reseed snapshots (local-only ground-truth artifacts)
snapshots/

# Beads (local issue tracker — not synced via git)
.beads/
.beads-credential-key
.mcp.json

# Agent context (handoffs, plans — local only)
agent-context/

# Local-only docs (not synced to the public repo)
docs/roadmap.md
docs/research/

# Graphify (knowledge-graph tooling output — regenerable, not synced)
graphify-out/

# pnpm store created by sandcastle containers (cross-device fallback from the
# bind-mounted repo; a cache — safe to delete, speeds up container installs)
.pnpm-store/
