{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "db:generate": "pnpm with-env drizzle-kit generate",
    "db:migrate": "pnpm with-env drizzle-kit migrate",
    "db:push": "pnpm with-env drizzle-kit push",
    "db:studio": "pnpm with-env drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@t3-oss/env-core": "^0.13.11",
    "drizzle-orm": "^0.44.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@types/ws": "^8.18.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./schema": "./src/schema.ts",
    "./ingestion": "./src/ingestion.ts",
    "./queries": "./src/queries/index.ts",
    "./importers/lastfm": "./src/importers/lastfm.ts",
    "./importers/source-fetcher": "./src/importers/source-fetcher.ts",
    "./enrichment": "./src/enrichment.ts"
  }
}
